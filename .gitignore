# Next dev output — kept separate from the build so the two cannot collide.
.next-dev/

# TypeScript incremental build artifacts — build output, not source.
*.tsbuildinfo

# Simulator captures dropped at the repo root while verifying mobile work.
# Untracked AND unignored is the bad combination: `git add -A` eventually
# swallows them, and 14MB of PNGs is not source.
orbit-video-editor/

# Vite writes these next to a config when it has to transpile it, and deletes
# them on a clean exit. Nine were committed by an interrupted build, each
# carrying an absolute path into someone else's node_modules — machine-local
# junk that could never work anywhere but the laptop that made it.
*.timestamp-*.mjs

{
  "name": "@layera-labs/orbit-pipeline",
  "version": "0.0.1",
  "private": true,
  "description": "Brief → ScenePlan → VideoProject. The part that DECIDES; @layera-labs/orbit-video is the part that renders.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run --config ../../vitest.config.ts --passWithNoTests",
    "spike": "node --experimental-strip-types src/spike/run.ts"
  },
  "dependencies": {
    "@layera-labs/orbit-shared": "workspace:*",
    "@layera-labs/orbit-video": "workspace:*",
    "@layera-labs/orbit-video-gen": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.8.0"
  },
  "sideEffects": false
}

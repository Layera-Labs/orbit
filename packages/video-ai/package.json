{
  "name": "@layera-labs/video-ai",
  "version": "0.0.1",
  "private": true,
  "description": "AI wedge: turn a natural-language prompt into a rendered Orbit video via templates",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run --config ../../vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@layera-labs/video": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.8.0"
  },
  "sideEffects": false,
  "//private": "The AI wedge. Carries @google/genai and is tied to the hosted service, not to an embeddable editor."
}

{
  "name": "@layera-labs/shared",
  "version": "1.0.0-beta.4",
  "description": "Shared utilities and types for Orbit SDK",
  "keywords": [
    "types",
    "utils",
    "shared",
    "canvas",
    "editor",
    "legacy"
  ],
  "license": "MIT",
  "author": "Layera Labs",
  "homepage": "https://github.com/Layera-Labs/orbit/tree/main/packages/shared#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Layera-Labs/orbit.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/Layera-Labs/orbit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "gen:version": "node scripts/gen-version.mjs",
    "build": "pnpm gen:version && tsc && vite build",
    "dev": "pnpm gen:version && vite build --watch --emptyOutDir false",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run --config ../../vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.8.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}

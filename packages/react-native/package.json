{
  "name": "@orbit/react-native",
  "version": "0.0.1",
  "private": true,
  "description": "React Native embedding for the Orbit editor: a typed bridge between RN and the WebView-hosted v2 web build",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite build --watch --emptyOutDir false",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run --config ../../vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@orbit/model": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-webview": ">=13"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-webview": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.8.0"
  },
  "sideEffects": false,
  "//private": "A bridge to a WebView-hosted v2 web build that is neither published nor hosted; the roadmap deprioritized this path. Not ready."
}

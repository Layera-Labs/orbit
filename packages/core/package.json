{
  "name": "@layera-labs/orbit-core",
  "version": "1.0.0-beta.4",
  "description": "Orbit Canvas Engine - Vanilla TypeScript core",
  "keywords": [
    "canvas",
    "fabricjs",
    "scene-graph",
    "editor",
    "engine",
    "design",
    "legacy"
  ],
  "license": "MIT",
  "author": "Layera Labs",
  "homepage": "https://github.com/Layera-Labs/orbit/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Layera-Labs/orbit.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Layera-Labs/orbit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite build --watch --emptyOutDir false",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run --config ../../vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@layera-labs/orbit-effects": "workspace:*",
    "@layera-labs/orbit-shared": "workspace:*",
    "fabric": "^6.9.1",
    "modern-gif": "^2.1.0",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@types/fabric": "^5.3.11",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.8.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}

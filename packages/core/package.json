{
  "name": "@orbit/core",
  "version": "0.0.1",
  "description": "Orbit Canvas Engine - Vanilla TypeScript core",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run --config ../../vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@orbit/effects": "workspace:*",
    "@orbit/shared": "workspace:*",
    "fabric": "^6.9.1",
    "modern-gif": "^2.1.0",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@types/fabric": "^5.3.11",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.8.0"
  },
  "sideEffects": false
}

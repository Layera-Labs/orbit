{
  "name": "@layera-labs/providers",
  "version": "1.0.0-beta.4",
  "description": "Pluggable template/font/background/photo provider interfaces for Orbit",
  "keywords": [
    "providers",
    "templates",
    "fonts",
    "stock-photos",
    "backgrounds",
    "editor",
    "plugin"
  ],
  "license": "MIT",
  "author": "Layera Labs",
  "homepage": "https://github.com/Layera-Labs/orbit/tree/main/packages/providers#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Layera-Labs/orbit.git",
    "directory": "packages/providers"
  },
  "bugs": {
    "url": "https://github.com/Layera-Labs/orbit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite build --watch --emptyOutDir false",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run --config ../../vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@layera-labs/model": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.8.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}

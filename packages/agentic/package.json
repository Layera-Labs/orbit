{
  "name": "@layera-labs/agentic",
  "version": "1.0.0-beta.4",
  "description": "Orbit AI Agentic Pipeline - Backend adapters",
  "keywords": [
    "ai",
    "image-generation",
    "inpainting",
    "outpainting",
    "canvas-agent",
    "editor",
    "optional"
  ],
  "license": "MIT",
  "author": "Layera Labs",
  "homepage": "https://github.com/Layera-Labs/orbit/tree/main/packages/agentic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Layera-Labs/orbit.git",
    "directory": "packages/agentic"
  },
  "bugs": {
    "url": "https://github.com/Layera-Labs/orbit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite build --watch --emptyOutDir false",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run --config ../../vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@layera-labs/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.8.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@layera-labs/orbit-video-gen",
  "version": "0.0.1",
  "private": true,
  "description": "Generative media (image/video/TTS) behind a credit-metered service — every call debits the billing ledger",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run --config ../../vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@layera-labs/orbit-billing": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.8.0"
  },
  "sideEffects": false,
  "//private": "Credit-metered generation over provider adapters; depends on the private @layera-labs/orbit-billing. Service-side."
}

{
  "name": "@layera-labs/editor",
  "version": "1.0.0-beta.1",
  "description": "Orbit canvas editor React UI (new architecture)",
  "license": "MIT",
  "author": "Layera Labs",
  "homepage": "https://github.com/Layera-Labs/orbit/tree/main/packages/editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Layera-Labs/orbit.git",
    "directory": "packages/editor"
  },
  "bugs": {
    "url": "https://github.com/Layera-Labs/orbit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite build --watch --emptyOutDir false",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run --config ../../vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@layera-labs/model": "workspace:*",
    "@layera-labs/providers": "workspace:*",
    "@layera-labs/render": "workspace:*",
    "framer-motion": "^12.40.0",
    "jspdf": "^2.5.2",
    "valtio": "^2.1.2"
  },
  "peerDependencies": {
    "konva": "^9.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-konva": "^18.2.10"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "konva": "^9.3.16",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-konva": "^18.2.10",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.8.0"
  },
  "sideEffects": false,
  "//publishConfig": "REGISTRY AND ACCESS ARE NOT DECIDED YET, so publishConfig is deliberately absent rather than guessed. Public npm needs {\"access\":\"public\"} (a scoped package defaults to restricted and the publish fails without it). GitHub Packages needs {\"registry\":\"https://npm.pkg.github.com\"}; the @layera-labs scope already matches the owning GitHub org, so nothing further has to be renamed. Add exactly one of those here before the first publish."
}

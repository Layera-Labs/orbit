{
  "name": "@orbit/ui",
  "version": "1.0.0-beta.1",
  "description": "Orbit UI Component Library - Shadcn-style registry",
  "license": "MIT",
  "author": "Layera Labs",
  "homepage": "https://github.com/Layera-Labs/orbit/tree/main/packages/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Layera-Labs/orbit.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/Layera-Labs/orbit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "cli"
  ],
  "bin": {
    "orbit-ui": "./cli/index.js"
  },
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite build --watch --emptyOutDir false",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run --config ../../vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@orbit/shared": "workspace:*",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.8.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "sideEffects": false,
  "//publishConfig": "REGISTRY AND ACCESS ARE NOT DECIDED YET, so publishConfig is deliberately absent rather than guessed. Public npm needs {\"access\":\"public\"} (a scoped package defaults to restricted and the publish fails without it). GitHub Packages needs {\"registry\":\"https://npm.pkg.github.com\"} and the @orbit scope would have to become @layera-labs. Add exactly one of those here before the first publish."
}

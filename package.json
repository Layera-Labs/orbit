{
  "name": "orbit",
  "private": true,
  "version": "0.0.0",
  "description": "Orbit Agentic Canvas Editor SDK",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=13",
    "lint": "turbo run lint",
    "test": "turbo run test && pnpm test:mobile",
    "//test:mobile": "apps/mobile is outside the pnpm workspace, so turbo never sees it. Globs all of src so a test added outside src/model still runs.",
    "test:mobile": "vitest run apps/mobile/src",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@vitest/coverage-v8": "^3.1.3",
    "jsdom": "^29.0.2",
    "prettier": "^3.2.5",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0",
    "vitepress": "1.6.3",
    "vitest": "3.1.3"
  },
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=20.0.0"
  }
}

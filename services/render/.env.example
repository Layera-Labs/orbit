# Orbit render service — copy to `.env` (gitignored) and fill in.
# The service reads these on start (see src/main.ts). Everything is optional:
# unset features simply return 503 / degrade, they don't crash the server.

# ─── Server ──────────────────────────────────────────────────────────────────
# Port to listen on (default 8787; the mobile app defaults to http://localhost:8787).
PORT=8787

# ─── Storage ─────────────────────────────────────────────────────────────────
# Postgres connection URL (Neon / Supabase / any Postgres). Credits + self-hosted
# users live here. SSL auto-enables for remote hosts. UNSET = in-memory, EPHEMERAL
# (resets on restart) — fine for local dev, never for production.
#   Neon:     postgres://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require
#   Supabase: postgres://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=

# Tests only — points the skipped Postgres integration test at a throwaway DB
# (`TEST_DATABASE_URL=… npm test`). Writes/cleans up test:* rows.
TEST_DATABASE_URL=

# ─── Auth ────────────────────────────────────────────────────────────────────
# EVERY route requires a bearer token — upload and render included. Being signed
# out is not the absence of one: a client asks POST /v1/auth/guest for a token
# this server signs, so "no login required" works without anything being
# anonymous. There is no way to turn this off; it replaced an X-Orbit-Account
# header the caller chose, which anyone could set to anyone else's account.
#
# Defaults to `selfhosted`. One of: selfhosted | clerk | supabase | firebase.
ORBIT_AUTH_PROVIDER=selfhosted

# REQUIRED IN PRODUCTION — signs every token. The server refuses to start
# without it when NODE_ENV=production; in dev it mints an ephemeral one and
# every token dies on restart. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORBIT_JWT_SECRET=

# Token lifetimes. A guest token is the device's ONLY handle on its own credits
# and renders (there is no password to sign back in with), so it is long-lived
# on purpose. Defaults: 30d / 365d.
ORBIT_JWT_TTL=
ORBIT_GUEST_JWT_TTL=

# Comma-separated origins allowed to call this service. UNSET = any origin,
# which is the default because Orbit is an embeddable SDK called from customers'
# own pages. That is safe here only because auth is a bearer token the client
# attaches itself — a hostile page cannot read it, so it is just another
# anonymous caller getting a 401.
ORBIT_ALLOWED_ORIGINS=

# This service's own public address, e.g. https://orbit-api.example.com. Used to
# build the password-reset link (→ the /reset page this service serves).
#
# It has to be STATED, not inferred from the request. Building the link from the
# incoming Host header is the classic reset-poisoning hole: anyone can POST to
# /v1/auth/forgot with a Host of their choosing and have a VALID reset token
# mailed to your user, pointed at their box.
ORBIT_PUBLIC_URL=

# License-key half of the account id (accountId = licenseKey:endUserId). Default "orbit".
ORBIT_LICENSE_KEY=orbit

# Credits granted once when a NEW account registers. Default 0 (off).
ORBIT_SIGNUP_BONUS=0

# selfhosted only — signing secret for the app's JWTs (any length; hashed to 256-bit).
ORBIT_JWT_SECRET=
# selfhosted optional — token issuer claim (default "orbit") and lifetime (default "30d").
ORBIT_JWT_ISSUER=orbit
ORBIT_JWT_TTL=30d

# clerk only
CLERK_ISSUER=            # e.g. https://your-app.clerk.accounts.dev
# CLERK_JWKS_URL=        # defaults to <issuer>/.well-known/jwks.json

# supabase only — Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# firebase only — the Firebase project id (token audience + issuer)
FIREBASE_PROJECT_ID=

# Legacy free-tier grant used ONLY when auth is disabled (anonymous accounts). Default 100.
ORBIT_FREE_CREDITS=100

# ─── Generation providers ────────────────────────────────────────────────────
# Runway — enables /v1/generate-image (10) and /v1/generate-video (60 muted / 100 + sound).
# Get one at https://dev.runwayml.com (Settings → API Keys).
RUNWAY_API_TOKEN=

# ElevenLabs — enables /v1/tts voiceover (5 credits), and narrates every scene
# of a generated video.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=   # default 21m00Tcm4TlvDq8ikWAM ("Rachel")
# ELEVENLABS_MODEL=      # default eleven_multilingual_v2

# ─── Generation (topic → video) ──────────────────────────────────────────────
# The language model that plans the scenes. Any OpenAI-compatible
# chat/completions endpoint — the base URL is the part BEFORE /chat/completions.
# All three, plus ELEVENLABS_API_KEY above, or POST /v1/generate reports itself
# unconfigured and the generation worker does not start.
ORBIT_LLM_BASE_URL=
ORBIT_LLM_MODEL=
ORBIT_LLM_API_KEY=
# Ask for JSON via response_format. On by default; set 0 for an endpoint that
# rejects it — the planner already tolerates a fenced or prose-wrapped reply.
# ORBIT_LLM_JSON_MODE=1
# ORBIT_LLM_TIMEOUT_MS=  # default 60000

# What one generated video costs, in credits. 0 (the default) leaves it
# unmetered, which is worth thinking about harder here than for rendering: a
# generation spends real money at the language model, once per scene at
# ElevenLabs, and again at the stock search, all before the encoder runs. At 25
# against the free tier of 100 above, a new account gets four videos.
#
# The credits are HELD when the job is accepted, not charged when it finishes —
# so a caller cannot start twenty generations on a balance that covers one — and
# settled only once a file exists. A generation that fails gives them back.
ORBIT_GENERATION_COST=0

# Stock footage. Unset, generation searches Openverse for CC0 stills, which
# needs no key at all and is why this works on a fresh box.
PEXELS_API_KEY=

# Set to 0 on a box that should accept generations but leave the work to
# another instance sharing the same DATABASE_URL.
# ORBIT_GENERATION_WORKER=1

# ─── Email (password reset) ──────────────────────────────────────────────────
# Transactional email for self-hosted password reset (POST /v1/auth/forgot).
# UNSET = reset is unavailable and /v1/auth/forgot returns 503 (never crashes).
# Only "resend" is supported today; setting RESEND_API_KEY alone implies it.
EMAIL_PROVIDER=resend
# Get a key at https://resend.com (API Keys). The user supplies this.
RESEND_API_KEY=
# From address; must be a verified Resend sender/domain. Default onboarding@resend.dev.
EMAIL_FROM=Orbit <onboarding@resend.dev>
# Optional override for where the reset link points — a deep link, or a page of
# your own; "?token=<jwt>" is appended. Leave it unset and the link is built
# from ORBIT_PUBLIC_URL below, pointing at the reset page this service serves at
# /reset. With NEITHER set, the raw token is emailed for the user to paste into
# the app — which works, but the token is a ~300-character JWT and mail clients
# wrap it, so prefer a link.
# EMAIL_RESET_URL_BASE=orbit://reset

# ─── Purchases (RevenueCat) ──────────────────────────────────────────────────
# Shared secret authenticating the RevenueCat purchase webhook (set the same value
# in RevenueCat → Integrations → Webhooks → Authorization header).
REVENUECAT_WEBHOOK_AUTH=

# Product id → credits granted, JSON. Must match your RevenueCat / store product ids.
# Default: {"credits_100":100,"credits_500":550,"credits_1200":1400}
# ORBIT_CREDIT_PACKS={"credits_100":100,"credits_500":550,"credits_1200":1400}

# ─── Dev ─────────────────────────────────────────────────────────────────────
# Set to 1 to enable the dev-only POST /v1/credits/grant top-up endpoint.
ORBIT_DEV_TOPUP=0

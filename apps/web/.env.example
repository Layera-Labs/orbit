# The render service (apps/render-service). Server-side only — the browser
# reaches generation endpoints through /api/orbit, never this host directly.
ORBIT_SERVER_URL=http://localhost:8787

# Upload and render are NOT proxied: /v1/render holds one connection for up to
# ten minutes and /v1/upload streams files up to 500 MB, neither of which
# survives a serverless function. The browser calls these two directly.
NEXT_PUBLIC_ORBIT_RENDER_URL=http://localhost:8787

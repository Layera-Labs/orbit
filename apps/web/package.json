    "@orbit/editor": "workspace:*",
    "@orbit/model": "workspace:*",
    "@orbit/providers": "workspace:*",
    "@orbit/render": "workspace:*",
    "@orbit/video": "workspace:*",
    "framer-motion": "^12.40.0",
    "idb": "^8.0.0",
    "jspdf": "^2.5.2",
    "konva": "^9.3.16",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-konva": "^18.2.10",
    "valtio": "^2.1.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.4.0",
    "vitest": "3.1.3"
  }

{
  "name": "@orbit/web",
  "private": true,
  "version": "1.0.0-beta.1",
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --passWithNoTests"

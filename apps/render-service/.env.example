# Orbit render service — copy to `.env` (gitignored) and fill in.
# The service reads these on start (see src/main.ts).

# Port to listen on (default 8787; the mobile app defaults to http://localhost:8787).
PORT=8787

# Replicate API token — enables POST /v1/generate-image (image generation).
# Get one at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Credits granted to each account on first use (the free tier). Default 100.
ORBIT_FREE_CREDITS=100

# Set to 1 to enable the dev-only POST /v1/credits/grant top-up endpoint.
ORBIT_DEV_TOPUP=0

# Gemini key — enables the older POST /v1/generate (prompt → template video).
# GEMINI_API_KEY=
